# Sentry QC RAG Assistant Configuration
# Rename or copy this file to .env and fill in your keys

# LLM Provider: "cohere" (recommended free tier), "anthropic", "ollama", or "none" (default offline)
LLM_PROVIDER=cohere

# Cohere API Key (Get a free API key at https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# Cohere Model (defaults to command-r-08-2024; also supports command-r, command-r-plus)
COHERE_MODEL=command-r-08-2024

# Embedding model for FAISS vector database (defaults to sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
